<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <PackageId>OpenSlideSharp</PackageId>
    <PackageTags>openslide wsi pathology whole-slide-image deepzoom</PackageTags>
    <Description>.NET bindings for OpenSlide 4.x (https://openslide.org/), with Deep Zoom and OME-Zarr generators.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSlideSharp.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <!-- The OME-Zarr metadata writer. net10.0 has it in the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
