{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://127.0.0.1:5000",
  "OpenSlide": {
    "SlideCacheSize": 10,
    "ColorMode": "Default",
    "DeepZoom": {
      "TileSize": 254,
      "Overlap": 1,
      "Format": "Jpeg",
      "Quality": 75,
      "LimitBounds": true
    },
    "OmeZarr": {
      "Version": "V0_5",
      "ChunkSize": 512,
      "Compression": "None",
      "LimitBounds": true,
      "AllowCrossOrigin": true
    }
  }
}
