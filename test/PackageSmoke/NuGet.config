<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="smoke-feed" value="../../artifacts/smoke-feed" />
    <!-- Third-party dependencies of the core (System.Memory on net48). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="smoke-feed">
      <package pattern="OpenSlideSharp" />
      <package pattern="OpenSlideSharp.SkiaSharp" />
      <package pattern="OpenSlideSharp.runtime" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
