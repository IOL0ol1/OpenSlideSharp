<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
  </PropertyGroup>

  <!--
    The release build passes OpenSlideUpstreamVersion, the openslide version of the bundled openslide-bin build (for
    example v4.0.1-49-g174630bf), so the assemblies say which OpenSlide they were released with:
    InformationalVersion is <version>+openslide.<upstream version>, without the git commit hash the SDK would append.
    Without it the SDK default stays (<version>+<commit>).
  -->
  <PropertyGroup Condition="'$(OpenSlideUpstreamVersion)' != ''">
    <InformationalVersion>$(Version)+openslide.$(OpenSlideUpstreamVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>IOL0ol1</Authors>
    <Copyright>Copyright (c) IOL0ol1</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/IOL0ol1/OpenSlideSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IOL0ol1/OpenSlideSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>openslide_logo.png</PackageIcon>
    <IsSrcProject>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)').StartsWith('$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), src))'))</IsSrcProject>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSrcProject)' == 'true' and '$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)openslide_logo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

</Project>
